APP_ENV=development
USE_MOCK_DATAHUB=true
USE_MOCK_LLM=true
USE_MOCK_EMBEDDING=true
USE_FAKE_OPENSEARCH=true
USE_IN_MEMORY_DATABASE=true
USE_IN_MEMORY_QUEUE=true
ENABLE_NETWORK_ACCESS=false

AUTH_MODE=mock
AUTH_REQUIRED=false
ENABLE_DEV_ENDPOINTS=true

MOCK_DATA_PATH=app/data/mock_datahub
MOCK_DATAHUB_FIXTURES_PATH=app/data/mock_datahub

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
