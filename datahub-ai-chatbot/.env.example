# Application
APP_NAME=DataHub AI Chatbot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# DataHub
USE_MOCK_DATAHUB=true
MOCK_DATAHUB_FIXTURES_PATH=tests/fixtures/datahub
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_TOKEN=
DATAHUB_PAGE_SIZE=100
DATAHUB_REQUEST_TIMEOUT_SECONDS=30
DATAHUB_MAX_RETRIES=3
DATAHUB_SYNC_DRY_RUN=false

# Authentication
AUTH_MODE=mock
AUTH_REQUIRED=false
JWT_SECRET_KEY=dev-secret-change-in-production
ENABLE_DEV_ENDPOINTS=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/chatbot

# Redis
REDIS_URL=redis://localhost:6380/0

# OpenSearch
OPENSEARCH_URL=http://localhost:9201
OPENSEARCH_INDEX=datahub-rag-chunks-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Embedding
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-v1
EMBEDDING_DIMENSION=384

# LLM
LLM_PROVIDER=fireworks
LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash

# API Keys (set in production)
FIREWORKS_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# AWS (optional)
AWS_REGION=us-east-1

# Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Indexing
INDEX_MAX_RETRIES=3
INDEX_BATCH_SIZE=20
INDEX_POLL_INTERVAL_SECONDS=2

# LLM Settings
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Context
MAX_CONTEXT_CHUNKS=8
MAX_CONTEXT_CHARACTERS=24000

# Entity Resolution
ENTITY_RESOLVER_EXACT_THRESHOLD=1.0
ENTITY_RESOLVER_HIGH_THRESHOLD=0.9
ENTITY_RESOLVER_SUBSTRING_THRESHOLD=0.7
ENTITY_RESOLVER_AMBIGUITY_MARGIN=0.2

# Documents
LOCAL_STORAGE_PATH=./data/documents
MAX_DOCUMENT_SIZE_MB=20
DOCUMENT_ALLOWED_DOMAINS=
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=100
ENABLE_MALWARE_SCAN=false

# Sync
SYNC_MODE=incremental
SYNC_INTERVAL_SECONDS=300
SYNC_BATCH_SIZE=100
SYNC_MAX_RETRIES=3
DELETE_MODE=soft
